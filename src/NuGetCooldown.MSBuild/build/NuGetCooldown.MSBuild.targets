<Project>

  <PropertyGroup>
    <_NuGetCooldownShouldRun>false</_NuGetCooldownShouldRun>
    <_NuGetCooldownShouldRun
        Condition="'$(NuGetCooldownEnabled)' == 'true'
                   and '$(DesignTimeBuild)' != 'true'
                   and '$(ProjectAssetsFile)' != ''">true</_NuGetCooldownShouldRun>
  </PropertyGroup>

  <!--
    Computes the stamp file path. The path embeds a hash of the effective settings so that
    changing any NuGetCooldown* property invalidates previous clean results. Runs on every
    build (it is cheap) so the stamp is always registered with incremental clean.
  -->
  <Target Name="_NuGetCooldownPrepare"
          Condition="'$(_NuGetCooldownShouldRun)' == 'true' and Exists('$(ProjectAssetsFile)')">

    <PropertyGroup>
      <_NuGetCooldownConfigFile>$(NuGetCooldownConfigFile)</_NuGetCooldownConfigFile>
      <_NuGetCooldownConfigFile
          Condition="'$(_NuGetCooldownConfigFile)' == '' and '$(NuGetCooldownNoConfig)' != 'true'">$([MSBuild]::GetPathOfFileAbove('nuget-cooldown.json', '$(MSBuildProjectDirectory)'))</_NuGetCooldownConfigFile>
    </PropertyGroup>

    <ItemGroup>
      <_NuGetCooldownSettings Include="v2|$(NuGetCooldownDays)|$(NuGetCooldownHours)|$(NuGetCooldownScope)|$(NuGetCooldownWarnOnly)|$(NuGetCooldownOnUnknown)|$(NuGetCooldownOnUnlisted)|$(NuGetCooldownOnFeedError)|$(NuGetCooldownOnNotRestored)|$(NuGetCooldownSources)|$(NuGetCooldownAllow)|$(_NuGetCooldownConfigFile)|$(NuGetCooldownOffline)|$(NuGetCooldownNoCache)|$(NuGetCooldownNoConfig)|$(NuGetCooldownCacheDir)" />
    </ItemGroup>

    <Hash ItemsToHash="@(_NuGetCooldownSettings)">
      <Output TaskParameter="HashResult" PropertyName="_NuGetCooldownSettingsHash" />
    </Hash>

    <PropertyGroup>
      <_NuGetCooldownStampFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'NuGetCooldown.$(_NuGetCooldownSettingsHash).stamp'))</_NuGetCooldownStampFile>
    </PropertyGroup>

    <ItemGroup>
      <FileWrites Include="$(_NuGetCooldownStampFile)" />
    </ItemGroup>
  </Target>

  <!--
    The check itself. Incremental: after a fully clean check the runner writes the stamp, and
    the target is skipped until the assets file or the config changes. That is safe because a
    package that has cleared its cooldown only gets older; new violations can only enter via a
    dependency-graph change. Findings (or warn-only mode) suppress the stamp, so they are
    reported again on every build.
  -->
  <Target Name="NuGetCooldownCheck"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolvePackageAssets;_NuGetCooldownPrepare"
          Inputs="$(ProjectAssetsFile);$(_NuGetCooldownConfigFile)"
          Outputs="$(_NuGetCooldownStampFile)"
          Condition="'$(_NuGetCooldownShouldRun)' == 'true' and Exists('$(ProjectAssetsFile)')">

    <Error Condition="!Exists('$(NuGetCooldownToolPath)')"
           Code="NCD999"
           Text="NuGetCooldown runner not found at '$(NuGetCooldownToolPath)'. Restore or reinstall the NuGetCooldown.MSBuild package." />

    <PropertyGroup>
      <!-- dotnet SDK builds expose the host; VS/MSBuild.exe builds fall back to PATH. -->
      <_NuGetCooldownDotNet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_NuGetCooldownDotNet>
      <_NuGetCooldownDotNet Condition="'$(_NuGetCooldownDotNet)' == ''">dotnet</_NuGetCooldownDotNet>

      <_NuGetCooldownCmd>"$(_NuGetCooldownDotNet)" exec "$(NuGetCooldownToolPath)" check "$(ProjectAssetsFile)" --msbuild "$(MSBuildProjectFullPath)" --stamp-file "$(_NuGetCooldownStampFile)"</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownDays)' != ''">$(_NuGetCooldownCmd) --days $(NuGetCooldownDays)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownHours)' != ''">$(_NuGetCooldownCmd) --hours $(NuGetCooldownHours)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownScope)' != ''">$(_NuGetCooldownCmd) --scope $(NuGetCooldownScope)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownWarnOnly)' == 'true'">$(_NuGetCooldownCmd) --warn-only</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownOnUnknown)' != ''">$(_NuGetCooldownCmd) --on-unknown $(NuGetCooldownOnUnknown)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownOnUnlisted)' != ''">$(_NuGetCooldownCmd) --on-unlisted $(NuGetCooldownOnUnlisted)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownOnFeedError)' != ''">$(_NuGetCooldownCmd) --on-feed-error $(NuGetCooldownOnFeedError)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownOnNotRestored)' != ''">$(_NuGetCooldownCmd) --on-not-restored $(NuGetCooldownOnNotRestored)</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownSources)' != ''">$(_NuGetCooldownCmd) --source "$(NuGetCooldownSources)"</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownAllow)' != ''">$(_NuGetCooldownCmd) --allow "$(NuGetCooldownAllow)"</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(_NuGetCooldownConfigFile)' != ''">$(_NuGetCooldownCmd) --config "$(_NuGetCooldownConfigFile)"</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownNoConfig)' == 'true'">$(_NuGetCooldownCmd) --no-config</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownOffline)' == 'true'">$(_NuGetCooldownCmd) --offline</_NuGetCooldownCmd>
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownNoCache)' == 'true'">$(_NuGetCooldownCmd) --no-cache</_NuGetCooldownCmd>
      <!-- Trim any trailing separator so a value like C:\cache\ does not turn the closing quote into an escaped literal. -->
      <_NuGetCooldownCmd Condition="'$(NuGetCooldownCacheDir)' != ''">$(_NuGetCooldownCmd) --cache-dir "$(NuGetCooldownCacheDir.TrimEnd('\').TrimEnd('/'))"</_NuGetCooldownCmd>
    </PropertyGroup>

    <!--
      Findings are reported through MSBuild's canonical error/warning format, which Exec
      parses from stdout — those lines fail the build by themselves. IgnoreExitCode avoids a
      redundant "exited with code 1" error on top; the explicit Error below catches abnormal
      exits (missing runtime, crash) that produced no canonical output.
    -->
    <Exec Command="$(_NuGetCooldownCmd)"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="high">
      <Output TaskParameter="ExitCode" PropertyName="_NuGetCooldownExitCode" />
    </Exec>

    <Error Condition="'$(_NuGetCooldownExitCode)' != '0' and '$(_NuGetCooldownExitCode)' != '1'"
           Code="NCD999"
           Text="The NuGetCooldown runner failed with exit code $(_NuGetCooldownExitCode). Command: $(_NuGetCooldownCmd)" />
  </Target>

</Project>
