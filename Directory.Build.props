<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Package metadata shared by every packable project. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Authors>George Andguladze</Authors>
    <Copyright>Copyright (c) 2026 George Andguladze</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/astralmaster/NuGetCooldown</PackageProjectUrl>
    <RepositoryUrl>https://github.com/astralmaster/NuGetCooldown</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>nuget;security;supply-chain;cooldown;minimum-release-age;dependencies;dotnet-tool;msbuild;devsecops</PackageTags>
    <PackageReleaseNotes>https://github.com/astralmaster/NuGetCooldown/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
